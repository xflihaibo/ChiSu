{
  "manifest_version": 3,
  "name": "ChiSu - Pixel Perfect Ruler（网页像素尺/取色器） & UI Measure Tool(前端像素眼)",
  "short_name": "ChiSu",
  "version": "1.0.2",
  "description": "featuring a high-precision Color Picker, Pixel Ruler, and Spacing Measurement for pixel-perfect CSS debugging.",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "打开 DevLens"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
